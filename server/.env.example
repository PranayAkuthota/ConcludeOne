# Server Port (Render sets this dynamically)
PORT=3005

# MongoDB Connection String (e.g. MongoDB Atlas cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/conclude_one?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=conclude_one_jwt_secret_key_2026_super_secure

# AI Provider API Keys (at least one is required)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# GROQ_API_KEY=your_groq_key_here

# AI Provider Selection: gemini | openrouter | groq (default: gemini)
AI_PROVIDER=gemini

# Optional: Custom Models
# RECOMMENDATION_MODEL=gemini-2.5-flash
# MEETING_MODEL=gemini-2.5-flash-lite
# GROQ_MODEL=llama3-8b-8192
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ChromaDB Vector Store URL (optional, falls back gracefully if not running)
CHROMA_URL=http://localhost:8000
